import React, { useState } from 'react';
import { Users, FileBarChart2, Search, Filter, TrendingUp, DollarSign, Calendar, ShoppingBag, Download, Printer, Shield, UserCheck, Award, Eye, ArrowUpRight } from 'lucide-react';
import { useERP } from '../../context/ERPContext';

export const UserReportsModule: React.FC = () => {
  const { users, salesOrders, activeUser, setActiveModule, setSelectedPrintOrder } = useERP();

  const [selectedUserId, setSelectedUserId] = useState<string>('all');
  const [searchTerm, setSearchTerm] = useState('');
  const [memoSearchQuery, setMemoSearchQuery] = useState('');
  const [timeFilter, setTimeFilter] = useState<'all' | 'today' | 'week' | 'month' | 'custom'>('all');

  const todayStr = new Date().toISOString().split('T')[0];
  const [startDate, setStartDate] = useState<string>(todayStr);
  const [endDate, setEndDate] = useState<string>(todayStr);

  // Filter users
  const executiveUsers = users.filter((u) => u.role !== 'Admin' || selectedUserId === u.id);

  // Helper to compute sales for a specific user
  const getUserSalesData = (userId: string, userName: string) => {
    // Matches createdBy or sales
    let userOrders = salesOrders.filter((so) => {
      if (!so.createdBy) return false;
      const createdLower = so.createdBy.toLowerCase();
      const nameLower = userName.toLowerCase();
      const idLower = userId.toLowerCase();
      return createdLower.includes(nameLower) || createdLower.includes(idLower) || createdLower === idLower;
    });

    // Time filter
    const now = new Date();
    if (timeFilter === 'today') {
      const today = now.toISOString().split('T')[0];
      userOrders = userOrders.filter((o) => o.orderDate.startsWith(today));
    } else if (timeFilter === 'week') {
      const sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
      userOrders = userOrders.filter((o) => new Date(o.orderDate) >= sevenDaysAgo);
    } else if (timeFilter === 'month') {
      const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
      userOrders = userOrders.filter((o) => new Date(o.orderDate) >= startOfMonth);
    } else if (timeFilter === 'custom' && startDate && endDate) {
      userOrders = userOrders.filter((o) => {
        const oDate = o.orderDate.split('T')[0];
        return oDate >= startDate && oDate <= endDate;
      });
    }

    const totalOrdersCount = userOrders.length;
    const totalSalesAmount = userOrders.reduce((sum, o) => sum + (o.grandTotal || 0), 0);
    const totalPaidAmount = userOrders.reduce((sum, o) => sum + (o.advancePaid || (o.grandTotal - o.dueAmount) || 0), 0);
    const avgOrderValue = totalOrdersCount > 0 ? totalSalesAmount / totalOrdersCount : 0;

    return {
      userOrders,
      totalOrdersCount,
      totalSalesAmount,
      totalPaidAmount,
      avgOrderValue,
    };
  };

  // Compute stats across all executives
  const usersWithStats = users.map((u) => {
    const stats = getUserSalesData(u.id, u.name);
    return {
      ...u,
      ...stats,
    };
  });

  const filteredUsers = usersWithStats.filter((u) => {
    const matchesUser = selectedUserId === 'all' || u.id === selectedUserId;
    const matchesSearch =
      u.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      u.email.toLowerCase().includes(searchTerm.toLowerCase()) ||
      (u.username && u.username.toLowerCase().includes(searchTerm.toLowerCase()));
    return matchesUser && matchesSearch;
  });

  // Global KPIs
  const grandTotalSales = salesOrders.reduce((sum, o) => sum + (o.grandTotal || 0), 0);
  const totalInvoices = salesOrders.length;
  const topSalesUser = [...usersWithStats].sort((a, b) => b.totalSalesAmount - a.totalSalesAmount)[0];

  const getInitials = (name: string) => {
    return name
      .split(' ')
      .map((n) => n[0])
      .slice(0, 2)
      .join('')
      .toUpperCase();
  };

  const handlePrintInvoice = (order: typeof salesOrders[0]) => {
    setSelectedPrintOrder(order);
    setActiveModule('invoice_print');
  };

  // CSV Export for User Reports
  const handleExportUserReportCSV = () => {
    const headers = ['User Name', 'Role', 'Username/ID', 'Total Invoices', 'Total Sales (BDT)', 'Total Collected (BDT)', 'Average Order Value (BDT)'];
    const rows = filteredUsers.map((u) => [
      `"${u.name}"`,
      `"${u.role}"`,
      `"${u.username || u.id}"`,
      u.totalOrdersCount,
      u.totalSalesAmount,
      u.totalPaidAmount,
      Math.round(u.avgOrderValue),
    ]);

    let csvContent = 'data:text/csv;charset=utf-8,\uFEFF';
    csvContent += `Report Date Range: ${timeFilter === 'custom' ? `${startDate} to ${endDate}` : timeFilter}\n\n`;
    csvContent += headers.join(',') + '\n';
    rows.forEach((rowArray) => {
      csvContent += rowArray.join(',') + '\n';
    });

    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute('download', `User_Wise_Sales_Report_${timeFilter === 'custom' ? `${startDate}_to_${endDate}` : timeFilter}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  // Quick Memo Finder matched list
  const matchedMemos = memoSearchQuery.trim()
    ? salesOrders.filter(
        (so) =>
          so.id.toLowerCase().includes(memoSearchQuery.trim().toLowerCase()) ||
          so.customerName.toLowerCase().includes(memoSearchQuery.trim().toLowerCase()) ||
          (so.customerPhone && so.customerPhone.includes(memoSearchQuery.trim()))
      )
    : [];

  return (
    <div className="space-y-6 pb-12">
      {/* Header Banner */}
      <div className="bg-gradient-to-r from-blue-900 via-slate-900 to-indigo-950 rounded-2xl p-6 text-white shadow-lg border border-slate-800">
        <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div className="space-y-1">
            <div className="flex items-center gap-2">
              <div className="p-2 bg-blue-500/20 rounded-xl border border-blue-400/30">
                <FileBarChart2 className="h-6 w-6 text-blue-400" />
              </div>
              <h1 className="text-xl font-bold tracking-tight">ইউজার সেলস ও পারফরম্যান্স রিপোর্ট (User Reports)</h1>
            </div>
            <p className="text-xs text-slate-300">
              সকল সেলস এক্সিকিউটিভ ও স্টাফদের নিজস্ব সেলস রিপোর্ট, ইনভয়েস সংখ্যা ও কালেকশন স্টেটমেন্ট।
            </p>
          </div>

          <div className="flex flex-wrap items-center gap-2">
            <span className="text-xs text-blue-200 font-medium">সময়সীমা:</span>
            <div className="flex flex-wrap bg-slate-800/80 p-1 rounded-xl border border-slate-700 gap-1">
              {(['all', 'today', 'week', 'month', 'custom'] as const).map((tf) => (
                <button
                  key={tf}
                  onClick={() => setTimeFilter(tf)}
                  className={`px-3 py-1 rounded-lg text-xs font-bold transition-all cursor-pointer ${
                    timeFilter === tf ? 'bg-blue-600 text-white shadow' : 'text-slate-400 hover:text-white'
                  }`}
                >
                  {tf === 'all'
                    ? 'সব (All)'
                    : tf === 'today'
                    ? 'আজ (Today)'
                    : tf === 'week'
                    ? 'এই সপ্তাহ'
                    : tf === 'month'
                    ? 'এই মাস'
                    : '📅 কাস্টম তারিখ (Custom Date)'}
                </button>
              ))}
            </div>

            <button
              onClick={handleExportUserReportCSV}
              className="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer ml-auto sm:ml-0"
              title="Download CSV Report for selected date range"
            >
              <Download className="h-4 w-4" />
              <span>ডাউনলোড রিপোর্ট (CSV)</span>
            </button>
          </div>
        </div>

        {/* Custom Date Selector Bar */}
        {timeFilter === 'custom' && (
          <div className="mt-4 pt-3 border-t border-slate-700/60 flex flex-wrap items-center gap-3 bg-slate-900/60 p-3 rounded-xl">
            <span className="text-xs font-bold text-amber-300 flex items-center gap-1">
              <Calendar className="h-4 w-4" />
              কাস্টম তারিখ রেঞ্জ বাছুন:
            </span>
            <div className="flex items-center gap-2">
              <span className="text-xs text-slate-300">শুরু (Start):</span>
              <input
                type="date"
                value={startDate}
                onChange={(e) => setStartDate(e.target.value)}
                className="bg-slate-800 border border-slate-600 text-white text-xs rounded-lg px-2.5 py-1 font-mono focus:border-blue-400 focus:outline-hidden"
              />
            </div>
            <div className="flex items-center gap-2">
              <span className="text-xs text-slate-300">শেষ (End):</span>
              <input
                type="date"
                value={endDate}
                onChange={(e) => setEndDate(e.target.value)}
                className="bg-slate-800 border border-slate-600 text-white text-xs rounded-lg px-2.5 py-1 font-mono focus:border-blue-400 focus:outline-hidden"
              />
            </div>
            <span className="text-[11px] text-blue-300 font-medium">
              ({startDate} থেকে {endDate} পর্যন্ত ফিল্টার করা হয়েছে)
            </span>
          </div>
        )}
      </div>

      {/* QUICK MEMO FINDER SEARCH BAR */}
      <div className="bg-gradient-to-r from-blue-50 via-indigo-50 to-purple-50 p-4 rounded-2xl border border-blue-200/80 shadow-xs space-y-3">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <div className="p-2 bg-blue-600 text-white rounded-xl shadow-xs">
              <Search className="h-5 w-5" />
            </div>
            <div>
              <h2 className="text-sm font-bold text-slate-900">🔍 দ্রুত মেমো ও ইনভয়েস সার্চ বার (Memo Quick Finder)</h2>
              <p className="text-[11px] text-slate-600">
                যেকোনো মেমো নাম্বার (e.g. SO-10001), কাস্টমার নাম বা মোবাইল নাম্বার টাইপ করে সাথে সাথে মেমো খুঁজে বের করুন।
              </p>
            </div>
          </div>

          <div className="relative w-full sm:w-80">
            <Search className="absolute left-3 top-2.5 h-4 w-4 text-blue-600" />
            <input
              type="text"
              value={memoSearchQuery}
              onChange={(e) => setMemoSearchQuery(e.target.value)}
              placeholder="মেমো নং (SO-10001), নাম বা ফোন নাম্বার দিন..."
              className="w-full rounded-xl border border-blue-300 bg-white pl-9 pr-3 py-2 text-xs font-semibold text-slate-900 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 focus:outline-hidden shadow-2xs"
            />
            {memoSearchQuery && (
              <button
                onClick={() => setMemoSearchQuery('')}
                className="absolute right-2.5 top-2 text-xs text-slate-400 hover:text-slate-600 font-bold"
              >
                ✕
              </button>
            )}
          </div>
        </div>

        {/* Matched Memos Quick Results Dropdown / Grid */}
        {memoSearchQuery.trim() !== '' && (
          <div className="bg-white rounded-xl border border-blue-200 p-3 shadow-md space-y-2">
            <div className="flex items-center justify-between text-xs border-b border-slate-100 pb-2">
              <span className="font-bold text-slate-800">
                সন্ধানের ফলাফল: <span className="text-blue-600">{matchedMemos.length}</span> টি মেমো পাওয়া গেছে
              </span>
              <span className="text-[10px] text-slate-400">মেমো তে ক্লিক করে সরাসরি প্রিন্ট করুন</span>
            </div>

            {matchedMemos.length === 0 ? (
              <p className="text-xs text-slate-500 p-2 text-center">
                "{memoSearchQuery}" দিয়ে কোন মেমো / ইনভয়েস পাওয়া যায়নি।
              </p>
            ) : (
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2.5 max-h-60 overflow-y-auto pt-1">
                {matchedMemos.map((m) => (
                  <div
                    key={m.id}
                    onClick={() => handlePrintInvoice(m)}
                    className="p-2.5 rounded-xl border border-slate-200 hover:border-blue-400 hover:bg-blue-50/60 transition-all cursor-pointer flex items-center justify-between group shadow-2xs"
                  >
                    <div>
                      <div className="flex items-center gap-1.5">
                        <span className="font-mono font-bold text-blue-900 text-xs">{m.id}</span>
                        <span className="text-[10px] bg-slate-100 group-hover:bg-blue-100 text-slate-700 px-1.5 py-0.2 rounded font-semibold">
                          {m.paymentStatus}
                        </span>
                      </div>
                      <span className="text-xs font-bold text-slate-800 block mt-0.5">{m.customerName}</span>
                      <span className="text-[10px] text-slate-500">{m.customerPhone || 'N/A'} • {m.orderDate}</span>
                    </div>

                    <div className="text-right">
                      <span className="text-xs font-black text-emerald-700 block">৳{(m.grandTotal || 0).toLocaleString()}</span>
                      <span className="text-[10px] font-bold text-blue-600 group-hover:underline flex items-center gap-0.5 justify-end mt-1">
                        <Printer className="h-3 w-3" /> প্রিন্ট মেমো
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}
      </div>

      {/* KPI Cards */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
          <div>
            <span className="text-xs font-bold text-slate-500 uppercase tracking-wider block">মোট নিবন্ধিত ইউজার</span>
            <div className="text-xl font-black text-slate-900 mt-1">{users.length} জন</div>
            <p className="text-[10px] text-emerald-600 font-semibold mt-0.5">
              {users.filter((u) => u.status === 'Active').length} Active Staff Members
            </p>
          </div>
          <div className="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-100">
            <Users className="h-6 w-6" />
          </div>
        </div>

        <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
          <div>
            <span className="text-xs font-bold text-slate-500 uppercase tracking-wider block">মোট ইনভয়েস বিক্রয়</span>
            <div className="text-xl font-black text-blue-900 mt-1">৳{grandTotalSales.toLocaleString()}</div>
            <p className="text-[10px] text-slate-500 mt-0.5">{totalInvoices} টি ইনভয়েস তৈরি করা হয়েছে</p>
          </div>
          <div className="w-11 h-11 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center border border-emerald-100">
            <DollarSign className="h-6 w-6" />
          </div>
        </div>

        <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
          <div>
            <span className="text-xs font-bold text-slate-500 uppercase tracking-wider block">সেরা সেলস এক্সিকিউটিভ</span>
            <div className="text-sm font-bold text-slate-900 truncate max-w-[150px] mt-1">
              {topSalesUser ? topSalesUser.name : 'N/A'}
            </div>
            <p className="text-[10px] text-emerald-600 font-bold mt-0.5">
              ৳{(topSalesUser?.totalSalesAmount || 0).toLocaleString()} (
              {topSalesUser?.totalOrdersCount || 0} Invoices)
            </p>
          </div>
          <div className="w-11 h-11 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center border border-amber-100">
            <Award className="h-6 w-6" />
          </div>
        </div>

        <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
          <div>
            <span className="text-xs font-bold text-slate-500 uppercase tracking-wider block">ইনভয়েস গড় মূল্য (AOV)</span>
            <div className="text-xl font-black text-indigo-900 mt-1">
              ৳{totalInvoices > 0 ? Math.round(grandTotalSales / totalInvoices).toLocaleString() : 0}
            </div>
            <p className="text-[10px] text-slate-500 mt-0.5">প্রতিটি অর্ডারের গড় মান</p>
          </div>
          <div className="w-11 h-11 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center border border-indigo-100">
            <TrendingUp className="h-6 w-6" />
          </div>
        </div>
      </div>

      {/* Filter Bar */}
      <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col md:flex-row items-center justify-between gap-4">
        <div className="flex items-center gap-2 w-full md:w-auto">
          <Filter className="h-4 w-4 text-slate-400" />
          <span className="text-xs font-bold text-slate-700">ইউজার ফিল্টার:</span>
          <select
            value={selectedUserId}
            onChange={(e) => setSelectedUserId(e.target.value)}
            className="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-800 bg-slate-50 focus:border-blue-600 focus:outline-hidden cursor-pointer min-w-[200px]"
          >
            <option value="all">সকল ইউজার ও স্টাফ (All Users)</option>
            {users.map((u) => (
              <option key={u.id} value={u.id}>
                {u.name} ({u.role} - {u.username || u.id})
              </option>
            ))}
          </select>
        </div>

        <div className="relative w-full md:w-72">
          <Search className="absolute left-3 top-2.5 h-4 w-4 text-slate-400" />
          <input
            type="text"
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            placeholder="ইউজার নাম বা ইমেইল দিয়ে খুঁজুন..."
            className="w-full rounded-xl border border-slate-300 pl-9 pr-3 py-1.5 text-xs focus:border-blue-600 focus:outline-hidden"
          />
        </div>
      </div>

      {/* Users Performance Summary Table */}
      <div className="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
        <div className="px-5 py-3.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
          <h3 className="text-xs font-bold uppercase tracking-wider text-slate-800 flex items-center gap-2">
            <UserCheck className="h-4 w-4 text-blue-600" />
            <span>ইউজারভিত্তিক সেলস পারফরম্যান্স সামারি (User Activity Summary)</span>
          </h3>
          <span className="text-[10px] text-slate-500 font-mono">
            {filteredUsers.length} Users Listed
          </span>
        </div>

        <div className="overflow-x-auto">
          <table className="w-full text-left text-xs">
            <thead className="bg-slate-100 text-slate-600 border-b border-slate-200">
              <tr>
                <th className="py-3 px-4 font-semibold">ইউজার ও পদবী</th>
                <th className="py-3 px-4 font-semibold text-center">রোল (Role)</th>
                <th className="py-3 px-4 font-semibold text-center">মোট ইনভয়েস</th>
                <th className="py-3 px-4 font-semibold text-right">মোট সেলস (৳)</th>
                <th className="py-3 px-4 font-semibold text-right">মোট আদায় (৳)</th>
                <th className="py-3 px-4 font-semibold text-right">গড় ইনভয়েস (AOV)</th>
                <th className="py-3 px-4 font-semibold text-center">অ্যাকশন</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-200">
              {filteredUsers.map((u) => (
                <tr key={u.id} className="hover:bg-slate-50 transition-colors">
                  <td className="py-3.5 px-4">
                    <div className="flex items-center gap-3">
                      <div className="w-10 h-10 rounded-full bg-slate-200 border border-slate-300 overflow-hidden flex items-center justify-center shrink-0 font-bold text-xs text-slate-700">
                        {u.avatarUrl ? (
                          <img src={u.avatarUrl} alt={u.name} className="h-full w-full object-cover" />
                        ) : (
                          getInitials(u.name)
                        )}
                      </div>
                      <div>
                        <span className="font-bold text-slate-900 block text-xs">{u.name}</span>
                        <span className="text-[10px] text-slate-500 block">
                          {u.designation || u.role} • <span className="font-mono">{u.username || u.id}</span>
                        </span>
                      </div>
                    </div>
                  </td>
                  <td className="py-3.5 px-4 text-center">
                    <span
                      className={`inline-block px-2.5 py-0.5 rounded text-[10px] font-bold ${
                        u.role === 'Admin'
                          ? 'bg-purple-100 text-purple-800'
                          : u.role === 'Manager'
                          ? 'bg-blue-100 text-blue-800'
                          : 'bg-slate-100 text-slate-700'
                      }`}
                    >
                      {u.role}
                    </span>
                  </td>
                  <td className="py-3.5 px-4 text-center font-bold text-slate-800">
                    {u.totalOrdersCount} টি
                  </td>
                  <td className="py-3.5 px-4 text-right font-bold text-emerald-700">
                    ৳{u.totalSalesAmount.toLocaleString()}
                  </td>
                  <td className="py-3.5 px-4 text-right font-bold text-blue-700">
                    ৳{u.totalPaidAmount.toLocaleString()}
                  </td>
                  <td className="py-3.5 px-4 text-right font-mono font-semibold text-slate-700">
                    ৳{Math.round(u.avgOrderValue).toLocaleString()}
                  </td>
                  <td className="py-3.5 px-4 text-center">
                    <button
                      onClick={() => setSelectedUserId(u.id)}
                      className="px-2.5 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 text-[11px] font-bold border border-blue-200 transition-all cursor-pointer flex items-center gap-1 mx-auto"
                    >
                      <Eye className="h-3.5 w-3.5" />
                      <span>বিস্তারিত দেখুন</span>
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* Individual Detailed Sales Log Section */}
      {selectedUserId !== 'all' && (
        <div className="bg-white rounded-2xl border border-slate-200 shadow-xs p-5 space-y-4">
          {(() => {
            const targetUser = usersWithStats.find((u) => u.id === selectedUserId);
            if (!targetUser) return null;

            return (
              <>
                <div className="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-200 gap-3">
                  <div className="flex items-center gap-3">
                    <div className="w-12 h-12 rounded-full bg-blue-600 text-white overflow-hidden flex items-center justify-center font-bold text-base shrink-0">
                      {targetUser.avatarUrl ? (
                        <img src={targetUser.avatarUrl} alt={targetUser.name} className="h-full w-full object-cover" />
                      ) : (
                        getInitials(targetUser.name)
                      )}
                    </div>
                    <div>
                      <h3 className="text-base font-bold text-slate-900 flex items-center gap-2">
                        <span>{targetUser.name} এর বিক্রয় লগ (Sales History)</span>
                        <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800">
                          {targetUser.role}
                        </span>
                      </h3>
                      <p className="text-xs text-slate-500">
                        আইডি: <span className="font-mono">{targetUser.username || targetUser.id}</span> • ফোন: {targetUser.phone || 'N/A'} • ইমেইল: {targetUser.email}
                      </p>
                    </div>
                  </div>

                  <button
                    onClick={() => setSelectedUserId('all')}
                    className="px-3 py-1.5 rounded-xl border border-slate-300 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-bold cursor-pointer transition-all self-start sm:self-auto"
                  >
                    ← সকল ইউজার ভিউতে ফিরে যান
                  </button>
                </div>

                {targetUser.userOrders.length === 0 ? (
                  <div className="p-8 text-center bg-slate-50 rounded-xl border border-dashed border-slate-300">
                    <ShoppingBag className="h-8 w-8 text-slate-300 mx-auto mb-2" />
                    <p className="text-xs font-bold text-slate-600">এই সময়ের মধ্যে {targetUser.name} এর কোনো সেলস রেকর্ড পাওয়া যায়নি।</p>
                  </div>
                ) : (
                  <div className="overflow-x-auto">
                    <table className="w-full text-left text-xs">
                      <thead className="bg-slate-100 text-slate-600 border-b border-slate-200">
                        <tr>
                          <th className="py-2.5 px-3 font-semibold">মেমো / মেমো আইডি</th>
                          <th className="py-2.5 px-3 font-semibold">গ্রাহক (Customer)</th>
                          <th className="py-2.5 px-3 font-semibold">তারিখ</th>
                          <th className="py-2.5 px-3 font-semibold text-right">মোট মান (৳)</th>
                          <th className="py-2.5 px-3 font-semibold text-right">আদায়কৃত (৳)</th>
                          <th className="py-2.5 px-3 font-semibold text-center">স্ট্যাটাস</th>
                          <th className="py-2.5 px-3 font-semibold text-center">প্রিন্ট ইনভয়েস</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-200">
                        {targetUser.userOrders.map((o) => (
                          <tr key={o.id} className="hover:bg-slate-50">
                            <td className="py-2.5 px-3 font-mono font-bold text-blue-900">{o.id}</td>
                            <td className="py-2.5 px-3 font-semibold text-slate-800">{o.customerName}</td>
                            <td className="py-2.5 px-3 text-slate-600">{o.orderDate}</td>
                            <td className="py-2.5 px-3 text-right font-bold text-slate-900">
                              ৳{(o.grandTotal || 0).toLocaleString()}
                            </td>
                            <td className="py-2.5 px-3 text-right font-bold text-emerald-700">
                              ৳{(o.advancePaid || (o.grandTotal - o.dueAmount) || 0).toLocaleString()}
                            </td>
                            <td className="py-2.5 px-3 text-center">
                              <span
                                className={`px-2 py-0.5 rounded text-[10px] font-bold ${
                                  o.paymentStatus === 'Paid'
                                    ? 'bg-emerald-100 text-emerald-800'
                                    : o.paymentStatus === 'Partial'
                                    ? 'bg-amber-100 text-amber-800'
                                    : 'bg-rose-100 text-rose-800'
                                }`}
                              >
                                {o.paymentStatus}
                              </span>
                            </td>
                            <td className="py-2.5 px-3 text-center">
                              <button
                                onClick={() => handlePrintInvoice(o)}
                                className="p-1 rounded bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-slate-600 cursor-pointer"
                                title="Print Cash Memo Invoice"
                              >
                                <Printer className="h-4 w-4" />
                              </button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </>
            );
          })()}
        </div>
      )}
    </div>
  );
};
