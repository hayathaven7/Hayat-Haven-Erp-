import React, { useState } from 'react';
import { Lock, User, Key, Eye, EyeOff, ShieldCheck, ArrowRight, Building2, CheckCircle2 } from 'lucide-react';
import { useERP } from '../context/ERPContext';

interface LoginScreenProps {
  onOpenPublicStore?: () => void;
}

export const LoginScreen: React.FC<LoginScreenProps> = ({ onOpenPublicStore }) => {
  const { login, users, companySettings } = useERP();
  const [usernameOrId, setUsernameOrId] = useState('');
  const [password, setPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [errorMsg, setErrorMsg] = useState('');
  const [rememberMe, setRememberMe] = useState(true);

  const passwordInputRef = React.useRef<HTMLInputElement>(null);
  const [selectedUserNote, setSelectedUserNote] = useState<string>('');

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    setErrorMsg('');
    if (!usernameOrId.trim()) {
      setErrorMsg('দয়া করে আপনার ইউজার আইডি বা ইউজারনেম সিলেক্ট বা টাইপ করুন।');
      return;
    }
    if (!password) {
      setErrorMsg('দয়া করে পাসওয়ার্ড প্রবেশ করান।');
      return;
    }
    const success = login(usernameOrId, password);
    if (!success) {
      setErrorMsg('ইউজার আইডি বা পাসওয়ার্ড সঠিক নয়! দয়া করে সঠিক পাসওয়ার্ড দিয়ে পুনঃচেষ্টা করুন।');
    }
  };

  const handleSelectUser = (usr: typeof users[0]) => {
    setErrorMsg('');
    const loginKey = usr.username || usr.id;
    setUsernameOrId(loginKey);
    setPassword('');
    setSelectedUserNote(`ইউজার "${usr.name}" সিলেক্ট করা হয়েছে। দয়া করে আপনার পাসওয়ার্ড টাইপ করুন।`);
    if (passwordInputRef.current) {
      passwordInputRef.current.focus();
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/80 backdrop-blur-md p-4 overflow-y-auto">
      <div className="w-full max-w-md bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden my-auto">
        {/* Header Banner */}
        <div className="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 p-8 text-white relative">
          <div className="flex items-center gap-3 mb-2">
            <div className="h-10 w-10 rounded-xl bg-white/10 backdrop-blur-xs border border-white/20 flex items-center justify-center shrink-0">
              <Building2 className="h-6 w-6 text-amber-400" />
            </div>
            <div>
              <h1 className="text-xl font-black tracking-tight">{companySettings.companyName || 'HAYAT & HAVEN'}</h1>
              <p className="text-xs text-blue-200">Enterprise Resource Planning System</p>
            </div>
          </div>
          <p className="text-xs text-slate-300 mt-4 leading-relaxed font-sans">
            স্বাগতম! ইউজার আইডি (User ID/Name) এবং পাসওয়ার্ড দিয়ে সিস্টেমে লগইন করুন।
          </p>
        </div>

        {/* Login Form */}
        <div className="p-8 space-y-6">
          {onOpenPublicStore && (
            <button
              type="button"
              onClick={onOpenPublicStore}
              className="w-full bg-gradient-to-r from-emerald-600 via-teal-600 to-indigo-700 hover:from-emerald-500 hover:to-indigo-600 text-white font-black py-3 px-4 rounded-2xl text-xs flex items-center justify-center gap-2 shadow-md cursor-pointer transition-all border border-emerald-400"
            >
              <span>🛍️ কাস্টমার স্টোর / ই-কমার্স ওয়েবসাইট ব্রাউজ করুন</span>
            </button>
          )}

          <div className="flex items-center justify-between border-b border-slate-100 pb-3">
            <div className="flex items-center gap-2">
              <Lock className="h-4 w-4 text-blue-600" />
              <h2 className="text-base font-bold text-slate-900">User Login (লগইন)</h2>
            </div>
            <span className="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200 flex items-center gap-1">
              <ShieldCheck className="h-3 w-3" />
              Secure Auth
            </span>
          </div>

          {selectedUserNote && (
            <div className="bg-blue-50 border border-blue-200 text-blue-900 text-xs rounded-xl p-3 font-semibold flex items-center gap-2">
              <span className="shrink-0 text-blue-600 font-bold">ℹ️</span>
              <div>{selectedUserNote}</div>
            </div>
          )}

          {errorMsg && (
            <div className="bg-rose-50 border border-rose-200 text-rose-800 text-xs rounded-xl p-3 font-medium flex items-start gap-2">
              <span className="shrink-0 text-rose-500 font-bold">⚠️</span>
              <div>{errorMsg}</div>
            </div>
          )}

          <form onSubmit={handleSubmit} className="space-y-4">
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1.5">
                User ID / Username / Email *
              </label>
              <div className="relative">
                <User className="absolute left-3 top-2.5 h-4 w-4 text-slate-400" />
                <input
                  type="text"
                  autoFocus
                  value={usernameOrId}
                  onChange={(e) => setUsernameOrId(e.target.value)}
                  onKeyDown={(e) => {
                    if (e.key === 'Enter') {
                      e.preventDefault();
                      if (!password) {
                        passwordInputRef.current?.focus();
                      } else {
                        handleSubmit(e);
                      }
                    }
                  }}
                  placeholder="e.g. admin, USR-1001, rafiq"
                  className="w-full rounded-xl border border-slate-300 pl-9 pr-3 py-2 text-xs font-semibold text-slate-900 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 focus:outline-hidden transition-all"
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1.5">
                Password (পাসওয়ার্ড) *
              </label>
              <div className="relative">
                <Key className="absolute left-3 top-2.5 h-4 w-4 text-slate-400" />
                <input
                  ref={passwordInputRef}
                  type={showPassword ? 'text' : 'password'}
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  onKeyDown={(e) => {
                    if (e.key === 'Enter') {
                      e.preventDefault();
                      handleSubmit(e);
                    }
                  }}
                  placeholder="আপনার গোপন পাসওয়ার্ড লিখুন"
                  className="w-full rounded-xl border border-slate-300 pl-9 pr-10 py-2 text-xs font-semibold text-slate-900 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 focus:outline-hidden transition-all"
                />
                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  className="absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 cursor-pointer"
                >
                  {showPassword ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}
                </button>
              </div>
            </div>

            <div className="flex items-center justify-between text-xs pt-1">
              <label className="flex items-center gap-2 cursor-pointer select-none">
                <input
                  type="checkbox"
                  checked={rememberMe}
                  onChange={(e) => setRememberMe(e.target.checked)}
                  className="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                />
                <span className="text-slate-600 font-medium">Remember Login</span>
              </label>
              <span className="text-[11px] text-slate-500 font-medium">
                🔒 Protected Passwords
              </span>
            </div>

            <button
              type="submit"
              className="w-full rounded-xl bg-blue-900 hover:bg-blue-950 text-white py-2.5 text-xs font-bold shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>System Sign In (লগইন করুন)</span>
              <ArrowRight className="h-4 w-4" />
            </button>
          </form>

          {/* Quick User Select List */}
          <div className="pt-4 border-t border-slate-100 space-y-2">
            <div className="text-center">
              <label className="block text-[11px] font-bold text-slate-700 uppercase tracking-wider">
                কুইক ইউজার সিলেক্ট (Quick User Select)
              </label>
              <p className="text-[10px] text-slate-500">
                এক ক্লিকে আপনার ইউজার সিলেক্ট করুন এবং পাসওয়ার্ড দিয়ে লগইন করুন
              </p>
            </div>
            <div className="grid grid-cols-2 gap-2">
              {users.map((usr) => (
                <button
                  key={usr.id}
                  type="button"
                  onClick={() => handleSelectUser(usr)}
                  className={`flex flex-col items-start p-2.5 rounded-xl border transition-all text-left cursor-pointer group ${
                    usernameOrId.toLowerCase() === (usr.username || usr.id).toLowerCase()
                      ? 'border-blue-600 bg-blue-50 shadow-xs'
                      : 'border-slate-200 bg-slate-50 hover:bg-blue-50 hover:border-blue-300'
                  }`}
                >
                  <div className="flex items-center justify-between w-full">
                    <span className="text-xs font-bold text-slate-900 group-hover:text-blue-900 truncate">
                      {usr.name}
                    </span>
                    <span
                      className={`text-[9px] px-1.5 py-0.5 rounded font-bold ${
                        usr.role === 'Admin'
                          ? 'bg-purple-100 text-purple-800'
                          : usr.role === 'Manager'
                          ? 'bg-blue-100 text-blue-800'
                          : 'bg-slate-200 text-slate-700'
                      }`}
                    >
                      {usr.role}
                    </span>
                  </div>
                  <span className="text-[10px] text-slate-500 font-mono mt-0.5">
                    ID: {usr.username || usr.id}
                  </span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div className="bg-slate-50 px-6 py-3 border-t border-slate-100 text-[10px] text-slate-400 text-center font-mono">
          HAYAT & HAVEN ERP System • Encrypted Local Auth Engine
        </div>
      </div>
    </div>
  );
};
