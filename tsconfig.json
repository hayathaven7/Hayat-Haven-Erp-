import React, { useState } from 'react';
import {
  ShoppingBag,
  ShoppingCart,
  Search,
  Filter,
  Truck,
  ShieldCheck,
  PhoneCall,
  Clock,
  Sparkles,
  Plus,
  Minus,
  Trash2,
  CheckCircle,
  X,
  Star,
  ExternalLink,
  Tag,
  ArrowRight,
  ChevronRight,
  MessageSquare,
  Check,
  CreditCard,
  MapPin,
  HelpCircle,
  Share2,
  Eye,
  Heart,
  Store,
  SlidersHorizontal,
  Zap,
} from 'lucide-react';
import { useERP } from '../../context/ERPContext';
import { Product } from '../../types/erp';

interface CartItem {
  product: Product;
  quantity: number;
}

interface EcommerceStoreModuleProps {
  isPublicOnly?: boolean;
}

export const EcommerceStoreModule: React.FC<EcommerceStoreModuleProps> = ({ isPublicOnly }) => {
  const {
    products,
    categories,
    brands,
    companySettings,
    updateCompanySettings,
    createSalesOrder,
    customers,
    addCustomer,
    setActiveModule,
    salesOrders,
    pendingOrders,
    isAuthenticated,
  } = useERP();

  const isPublicView = isPublicOnly || !isAuthenticated;

  // Custom Domain & Link Share State
  const [customDomainInput, setCustomDomainInput] = useState(companySettings.customWebsiteDomain || 'hayathaven.vercel.app');
  const [copySuccessMsg, setCopySuccessMsg] = useState<string | null>(null);
  const [showDomainGuideModal, setShowDomainGuideModal] = useState(false);
  const [domainSavedNotice, setDomainSavedNotice] = useState(false);

  const activeSharedUrl = companySettings.customWebsiteDomain
    ? companySettings.customWebsiteDomain.startsWith('http')
      ? companySettings.customWebsiteDomain
      : `https://${companySettings.customWebsiteDomain}`
    : typeof window !== 'undefined'
    ? window.location.href
    : 'https://ais-pre-fu7mpnyvv3lswsuuljyzc6-18651801599.asia-east1.run.app';

  const handleSaveCustomDomain = (e: React.FormEvent) => {
    e.preventDefault();
    updateCompanySettings({ customWebsiteDomain: customDomainInput.trim() });
    setDomainSavedNotice(true);
    setTimeout(() => setDomainSavedNotice(false), 3000);
  };

  const handleCopyStoreLink = () => {
    navigator.clipboard.writeText(activeSharedUrl);
    setCopySuccessMsg('✅ লিংক কপি করা হয়েছে!');
    setTimeout(() => setCopySuccessMsg(null), 3000);
  };

  const handleShareWhatsApp = () => {
    const text = `আসসালামু আলাইকুম! ${companySettings.companyName} এর অনলাইন প্রোডাক্ট ক্যাটালগ ও কেনাকাটার ওয়েবসাইট লিংক: ${activeSharedUrl}`;
    window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
  };

  // Search & Filter State
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedCategory, setSelectedCategory] = useState<string>('All');
  const [selectedProductForModal, setSelectedProductForModal] = useState<Product | null>(null);

  // Cart State
  const [cart, setCart] = useState<CartItem[]>([]);
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [isCheckoutOpen, setIsCheckoutOpen] = useState(false);

  // Order Tracking State
  const [isTrackOrderOpen, setIsTrackOrderOpen] = useState(false);
  const [trackSearchQuery, setTrackSearchQuery] = useState('');

  // Checkout Form State
  const [customerName, setCustomerName] = useState('');
  const [customerPhone, setCustomerPhone] = useState('');
  const [customerAddress, setCustomerAddress] = useState('');
  const [deliveryArea, setDeliveryArea] = useState<'inside_dhaka' | 'outside_dhaka'>('inside_dhaka');
  const [paymentMethod, setPaymentMethod] = useState<'Cash' | 'bKash' | 'Nagad'>('Cash');
  const [couponCode, setCouponCode] = useState('');
  const [couponDiscountPercent, setCouponDiscountPercent] = useState(0);
  const [couponMsg, setCouponMsg] = useState('');
  const [customerNote, setCustomerNote] = useState('');

  // Order Confirmation Modal State
  const [placedOrderInfo, setPlacedOrderInfo] = useState<{
    orderId: string;
    totalAmount: number;
    itemsCount: number;
    customerName: string;
    phone: string;
    address: string;
  } | null>(null);

  // Helper resolvers
  const getCategoryName = (catId: string) => {
    const found = categories.find((c) => c.id === catId || c.name === catId);
    return found ? found.name : catId;
  };

  const getBrandName = (brandId: string) => {
    const found = brands.find((b) => b.id === brandId || b.name === brandId);
    return found ? found.name : brandId;
  };

  // Category List
  const activeCategories = ['All', ...categories.map((c) => c.name)];

  // Filtered Products
  const filteredProducts = products.filter((p) => {
    const catName = getCategoryName(p.categoryId);
    const bName = getBrandName(p.brandId);

    const matchesSearch =
      p.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
      p.barcode.toLowerCase().includes(searchQuery.toLowerCase()) ||
      catName.toLowerCase().includes(searchQuery.toLowerCase()) ||
      bName.toLowerCase().includes(searchQuery.toLowerCase());

    const matchesCategory =
      selectedCategory === 'All' || catName.toLowerCase() === selectedCategory.toLowerCase();

    return matchesSearch && matchesCategory;
  });

  // Cart Calculations
  const addToCart = (product: Product, qty: number = 1) => {
    setCart((prev) => {
      const existing = prev.find((item) => item.product.id === product.id);
      if (existing) {
        return prev.map((item) =>
          item.product.id === product.id ? { ...item, quantity: item.quantity + qty } : item
        );
      }
      return [...prev, { product, quantity: qty }];
    });
    setIsCartOpen(true);
  };

  const updateCartQuantity = (productId: string, newQty: number) => {
    if (newQty <= 0) {
      removeFromCart(productId);
      return;
    }
    setCart((prev) =>
      prev.map((item) => (item.product.id === productId ? { ...item, quantity: newQty } : item))
    );
  };

  const removeFromCart = (productId: string) => {
    setCart((prev) => prev.filter((item) => item.product.id !== productId));
  };

  const cartSubtotal = cart.reduce((acc, item) => acc + item.product.sellingPrice * item.quantity, 0);
  const deliveryCharge = deliveryArea === 'inside_dhaka' ? 80 : 150;
  const discountAmount = Math.round((cartSubtotal * couponDiscountPercent) / 100);
  const cartGrandTotal = Math.max(0, cartSubtotal + deliveryCharge - discountAmount);
  const totalCartItemsCount = cart.reduce((acc, item) => acc + item.quantity, 0);

  // Handle Apply Coupon
  const handleApplyCoupon = (e: React.FormEvent) => {
    e.preventDefault();
    if (couponCode.trim().toUpperCase() === 'HAYAT10' || couponCode.trim().toUpperCase() === 'SAVE10') {
      setCouponDiscountPercent(10);
      setCouponMsg('✅ ১০% কুপন ডিসকাউন্ট সফলভাবে যুক্ত হয়েছে!');
    } else if (couponCode.trim().toUpperCase() === 'FREE80') {
      setCouponDiscountPercent(15);
      setCouponMsg('✅ ১৫% স্পেশাল কুপন বোনাস অ্যাপ্লাইড!');
    } else {
      setCouponDiscountPercent(0);
      setCouponMsg('❌ ইনভ্যালিড কুপন কোড! ট্রাই করুন: HAYAT10');
    }
  };

  // Handle Place Order
  const handlePlaceOrder = (e: React.FormEvent) => {
    e.preventDefault();
    if (cart.length === 0) return alert('আপনার শপিং কার্ট খালি!');
    if (!customerName.trim() || !customerPhone.trim() || !customerAddress.trim()) {
      return alert('অনুগ্রহ করে আপনার নাম, মোবাইল নম্বর এবং ঠিকানা সঠিকভাবে লিখুন!');
    }

    if (customerPhone.trim().length < 11) {
      return alert('অনুগ্রহ করে ১১ ডিজিটের সঠিক মোবাইল নম্বর প্রদান করুন!');
    }

    // Find or create customer
    let cust = customers.find((c) => c.phone.trim() === customerPhone.trim());
    let custId = cust ? cust.id : '';

    if (!cust) {
      const createdCust = addCustomer({
        name: customerName,
        phone: customerPhone,
        address: customerAddress,
        email: `${customerPhone}@customer.com`,
        type: 'Retail',
        creditLimit: 0,
        openingBalance: 0,
        status: 'Active',
      });
      custId = createdCust.id;
    }

    // Build Order Items
    const orderItems = cart.map((item) => ({
      productId: item.product.id,
      productName: item.product.name,
      quantity: item.quantity,
      unitPrice: item.product.sellingPrice,
      totalPrice: item.product.sellingPrice * item.quantity,
    }));

    // Create Sales Order in ERP
    const createdOrder = createSalesOrder({
      customerId: custId,
      customerName: customerName,
      customerPhone: customerPhone,
      customerAddress: customerAddress,
      deliveryAddress: `${customerAddress} (${deliveryArea === 'inside_dhaka' ? 'Inside Dhaka' : 'Outside Dhaka'})`,
      orderType: 'Online',
      deliveryStatus: 'Pending',
      items: orderItems,
      discountAmount: discountAmount,
      deliveryCharge: deliveryCharge,
      advancePaid: paymentMethod === 'Cash' ? 0 : cartGrandTotal,
      paymentMethod: paymentMethod,
      notes: `E-Commerce Storefront Order | Coupon: ${couponCode || 'None'} | Note: ${customerNote}`,
      createdBy: 'Online Customer Storefront',
    });

    // Show Confirmation
    setPlacedOrderInfo({
      orderId: createdOrder.id,
      totalAmount: cartGrandTotal,
      itemsCount: totalCartItemsCount,
      customerName: customerName,
      phone: customerPhone,
      address: customerAddress,
    });

    // Reset Form & Cart
    setCart([]);
    setIsCheckoutOpen(false);
    setIsCartOpen(false);
  };

  return (
    <div className="space-y-6 pb-12 font-sans antialiased text-slate-800">
      {/* Top Header Banner */}
      {!isPublicView ? (
        <div className="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white rounded-2xl p-4 shadow-md flex flex-wrap items-center justify-between gap-4 border border-blue-700/40">
          <div className="flex items-center gap-3">
            <div className="p-2.5 bg-blue-600/30 rounded-xl border border-blue-400/30 text-blue-300 shrink-0">
              <Store className="h-6 w-6" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h2 className="text-sm sm:text-base font-extrabold tracking-tight">
                  {companySettings.companyName} • লাইভ ই-কমার্স ল্যান্ডিং পেজ ও অনলাইন স্টোর
                </h2>
                <span className="bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center gap-1">
                  <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping" />
                  লাইভ অটো সিঙ্কড উইথ ERP
                </span>
              </div>
              <p className="text-xs text-blue-200 mt-0.5">
                ERP তে প্রোডাক্ট যোগ করার সাথে সাথে এখানে অটোমেটিক শো করবে! কাস্টমাররা অর্ডার করলে তা সরাসরি ইআরপির Sales Orders এ চলে আসবে।
              </p>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <button
              onClick={() => setIsTrackOrderOpen(true)}
              className="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-xs transition-all cursor-pointer border border-indigo-400/30"
            >
              <Truck className="h-4 w-4 text-amber-300" />
              <span>অর্ডার ট্র্যাক ও হিস্টোরি</span>
            </button>

            <button
              onClick={() => setIsCartOpen(true)}
              className="relative flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs shadow-xs transition-all cursor-pointer"
            >
              <ShoppingCart className="h-4 w-4" />
              <span>শপিং কার্ট</span>
              {totalCartItemsCount > 0 && (
                <span className="bg-slate-950 text-amber-400 text-[11px] font-extrabold px-2 py-0.5 rounded-full border border-amber-400/40">
                  {totalCartItemsCount}
                </span>
              )}
            </button>

            <button
              onClick={() => setActiveModule('sales_orders')}
              className="flex items-center gap-1.5 bg-white/10 hover:bg-white/20 text-white font-semibold px-3 py-2 rounded-xl text-xs transition-all cursor-pointer border border-white/20"
            >
              <ExternalLink className="h-4 w-4" />
              <span>ইআরপি সেলস লিস্টে ফিরে যান</span>
            </button>
          </div>
        </div>
      ) : (
        /* Pure Customer Public Navigation Topbar */
        <div className="bg-slate-900 text-white rounded-2xl p-4 shadow-lg flex flex-wrap items-center justify-between gap-4 border border-slate-800">
          <div className="flex items-center gap-3">
            <div className="h-10 w-10 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center font-black text-lg shadow-md border border-blue-400/30">
              🛍️
            </div>
            <div>
              <h1 className="text-base sm:text-lg font-black tracking-tight text-white flex items-center gap-2">
                <span>{companySettings.companyName}</span>
                <span className="text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 px-2 py-0.5 rounded-full font-bold">
                  Verified Store
                </span>
              </h1>
              <p className="text-xs text-slate-300 font-medium">
                অফিসিয়াল অনলাইন স্টোর ও কাস্টমার শপিং পোরটাল
              </p>
            </div>
          </div>

          <div className="flex items-center gap-2.5">
            <a
              href={`https://wa.me/${(companySettings.phone || '').replace(/[^0-9]/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
              className="hidden sm:flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-500 text-white px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer shadow-2xs"
            >
              <MessageSquare className="h-4 w-4" />
              <span>হোয়াটসঅ্যাপ সাপোর্ট</span>
            </a>

            <button
              onClick={() => setIsTrackOrderOpen(true)}
              className="flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-3.5 py-2 rounded-xl text-xs shadow-2xs transition-all cursor-pointer border border-indigo-400/30"
            >
              <Truck className="h-4 w-4 text-amber-300" />
              <span>অর্ডার ট্র্যাক করুন</span>
            </button>

            <button
              onClick={() => setIsCartOpen(true)}
              className="relative flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black px-4 py-2 rounded-xl text-xs shadow-md transition-all cursor-pointer"
            >
              <ShoppingCart className="h-4 w-4" />
              <span>কার্ট</span>
              {totalCartItemsCount > 0 && (
                <span className="bg-slate-950 text-amber-400 text-[11px] font-extrabold px-2 py-0.5 rounded-full border border-amber-400/40">
                  {totalCartItemsCount}
                </span>
              )}
            </button>
          </div>
        </div>
      )}

      {/* Domain & Link Management Card (Only visible to Admin inside ERP) */}
      {!isPublicView && (
        <div className="bg-white rounded-2xl p-4 sm:p-5 border-2 border-indigo-200 shadow-xs space-y-4">
          <div className="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-100 pb-3">
            <div className="flex items-center gap-2.5">
              <div className="p-2 bg-indigo-50 text-indigo-700 rounded-xl border border-indigo-200">
                <Share2 className="h-5 w-5" />
              </div>
              <div>
                <h3 className="text-xs sm:text-sm font-black text-slate-900">
                  🌐 কাস্টমার ওয়েবসাইট অ্যাড্রেস ও শর্ট ডোমেন সেটিংস (Custom Store Link)
                </h3>
                <p className="text-[11px] text-slate-500">
                  ERP এর সব প্রোডাক্ট অটোমেটিক এই লিংকটিতে দেখাবে। লিংকটি কপি করে কাস্টমার বা ফেসবুকে শেয়ার করতে পারবেন।
                </p>
              </div>
            </div>

            <button
              type="button"
              onClick={() => setShowDomainGuideModal(true)}
              className="bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 font-bold px-3.5 py-1.5 rounded-xl text-xs flex items-center gap-1.5 cursor-pointer transition-all self-start md:self-auto"
            >
              <HelpCircle className="h-4 w-4 text-amber-600" />
              <span>কীভাবে ফ্রিতে hayathaven.vercel.app লিংক কানেক্ট করবেন?</span>
            </button>
          </div>

          {/* Saved Toast Notice */}
          {domainSavedNotice && (
            <div className="p-2.5 bg-emerald-50 text-emerald-800 border border-emerald-300 rounded-xl text-xs font-bold flex items-center gap-2 animate-bounce">
              <CheckCircle className="h-4 w-4 text-emerald-600" />
              <span>কাস্টম ডোমেইন সেভ করা হয়েছে!</span>
            </div>
          )}

          <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
            {/* Custom Domain Input Form */}
            <form onSubmit={handleSaveCustomDomain} className="space-y-2 bg-slate-50 p-3.5 rounded-xl border border-slate-200">
              <label className="block text-xs font-bold text-slate-800">
                ✏️ আপনার শপের পছন্দের শর্ট ডোমেইন (Custom Domain Alias):
              </label>
              <div className="flex gap-2">
                <input
                  type="text"
                  value={customDomainInput}
                  onChange={(e) => setCustomDomainInput(e.target.value)}
                  placeholder="যেমন: hayathaven.vercel.app বা hayathaven.com"
                  className="flex-1 bg-white border border-slate-300 px-3 py-2 rounded-xl text-xs font-mono font-bold text-slate-900 focus:border-indigo-600 focus:outline-hidden"
                />
                <button
                  type="submit"
                  className="bg-indigo-700 hover:bg-indigo-600 text-white font-bold px-4 py-2 rounded-xl text-xs cursor-pointer shadow-2xs transition-all shrink-0"
                >
                  সেভ করুন
                </button>
              </div>
              <p className="text-[11px] text-slate-500">
                * Vercel বা Netlify তে হোস্ট করলে আপনার পছন্দের নাম (যেমন {customDomainInput || 'hayathaven.vercel.app'}) দিয়ে ওয়েবসাইট তৈরি হবে।
              </p>
            </form>

            {/* Quick Share Actions */}
            <div className="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-2 flex flex-col justify-between">
              <label className="block text-xs font-bold text-slate-800">
                🔗 অ্যাক্টিভ ওয়েবসাইট লিংক (Active Store URL):
              </label>
              <div className="p-2 bg-white border border-slate-300 rounded-xl font-mono text-xs font-bold text-indigo-900 truncate">
                {activeSharedUrl}
              </div>

              <div className="flex flex-wrap items-center gap-2 pt-1">
                <button
                  type="button"
                  onClick={handleCopyStoreLink}
                  className="flex-1 bg-slate-900 hover:bg-slate-800 text-white font-bold px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 cursor-pointer transition-all shadow-2xs"
                >
                  <Share2 className="h-3.5 w-3.5 text-amber-300" />
                  <span>{copySuccessMsg || 'লিংক কপি করুন'}</span>
                </button>

                <button
                  type="button"
                  onClick={handleShareWhatsApp}
                  className="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3 py-2 rounded-xl text-xs flex items-center justify-center gap-1.5 cursor-pointer transition-all shadow-2xs"
                >
                  <MessageSquare className="h-3.5 w-3.5" />
                  <span>হোয়াটসঅ্যাপে শেয়ার করুন</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Hero Landing Section */}
      <div className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#002E5D] via-[#001E3D] to-[#0A0F1D] text-white p-6 sm:p-10 shadow-xl border border-blue-900/60">
        <div className="absolute top-0 right-0 -mt-10 -mr-10 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none" />
        <div className="absolute bottom-0 left-0 -mb-10 -ml-10 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none" />

        <div className="relative z-10 max-w-3xl space-y-4">
          <div className="inline-flex items-center gap-2 bg-blue-500/20 border border-blue-400/30 text-blue-200 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
            <Sparkles className="h-3.5 w-3.5 text-amber-300 animate-spin" />
            <span>প্রিমিয়াম ই-কমার্স ল্যান্ডিং পেজ & অনলাইন শপ</span>
          </div>

          <h1 className="text-2xl sm:text-4xl font-black tracking-tight leading-tight text-white">
            {companySettings.companyName} — আপনার পছন্দের অরিজিনাল পন্য কিনুন সরাসরি অনলাইন প্রাইসে!
          </h1>

          <p className="text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
