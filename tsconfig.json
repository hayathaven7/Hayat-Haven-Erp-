                      </p>
                    </div>
                  );
                }

                const matchedSales = salesOrders.filter(
                  (so) =>
                    (so.id && so.id.toLowerCase().includes(q)) ||
                    (so.customerPhone && so.customerPhone.toLowerCase().includes(q))
                );

                const matchedPending = pendingOrders.filter(
                  (po) =>
                    (po.id && po.id.toLowerCase().includes(q)) ||
                    (po.customerPhone && po.customerPhone.toLowerCase().includes(q))
