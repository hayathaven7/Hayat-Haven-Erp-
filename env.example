import { CompanySettings, Customer, Quotation, SalesOrder } from '../types/erp';

export function formatWhatsAppPhone(phone: string): string {
  let cleaned = phone.replace(/[^\d]/g, '');
  if (cleaned.startsWith('01')) {
    cleaned = '88' + cleaned;
  }
  return cleaned;
}

export function generateWhatsAppInvoiceMessage(
  order: SalesOrder,
  customer: Customer | undefined,
  company: CompanySettings
): string {
  const customerName = order.customerName || customer?.name || 'Valued Customer';
  const itemsText = order.items
    .map(
      (item, idx) =>
        `  ${idx + 1}. *${item.productName || item.productId}* x${item.quantity} @ ৳${item.unitPrice.toLocaleString()} = ৳${item.totalPrice.toLocaleString()}`
    )
    .join('\n');

  return `*${company.companyName}*
----------------------------------------
📄 *TAX INVOICE: ${order.id}*
👤 Customer: ${customerName}
📱 Phone: ${customer?.phone || 'N/A'}
📅 Order Date: ${order.orderDate}
💳 Status: *${order.paymentStatus.toUpperCase()}*

📦 *ORDER ITEMS:*
${itemsText}

----------------------------------------
💵 Subtotal: ৳${order.subtotal.toLocaleString()}
${order.discountAmount > 0 ? `🎁 Discount: -৳${order.discountAmount.toLocaleString()}\n` : ''}${order.deliveryCharge > 0 ? `🚚 Delivery: +৳${order.deliveryCharge.toLocaleString()}\n` : ''}💰 *GRAND TOTAL: ৳${order.grandTotal.toLocaleString()}*
✅ Advance / Paid: ৳${order.advancePaid.toLocaleString()}
⚠️ *DUE BALANCE: ৳${order.dueAmount.toLocaleString()}*
----------------------------------------

Thank you for choosing *${company.companyName}*!
For queries, call us at ${company.phone}.`;
}

export function openWhatsAppInvoice(
  order: SalesOrder,
  customer: Customer | undefined,
  company: CompanySettings,
  overridePhone?: string
) {
  const targetPhone = overridePhone || customer?.phone || company.phone;
  const formattedPhone = formatWhatsAppPhone(targetPhone);
  const message = generateWhatsAppInvoiceMessage(order, customer, company);
  const url = `https://api.whatsapp.com/send?phone=${formattedPhone}&text=${encodeURIComponent(message)}`;
  window.open(url, '_blank');
}

export function generateWhatsAppQuotationMessage(
  quotation: Quotation,
  customer: Customer | undefined,
  company: CompanySettings
): string {
  const customerName = quotation.customerName || customer?.name || 'Valued Client';
  const itemsText = quotation.items
    .map(
      (item, idx) =>
        `  ${idx + 1}. *${item.productName || item.productId}* x${item.quantity} @ ৳${item.unitPrice.toLocaleString()} = ৳${item.totalPrice.toLocaleString()}`
    )
    .join('\n');

  return `*${company.companyName}*
----------------------------------------
📋 *OFFICIAL QUOTATION / PRICE ESTIMATE*
🔢 Ref No: *${quotation.id}*
👤 Client: ${customerName}
📅 Date: ${quotation.quotationDate}
⌛ Valid Until: *${quotation.validUntil}*

📦 *QUOTATION ITEMS:*
${itemsText}

----------------------------------------
💵 Subtotal: ৳${quotation.subtotal.toLocaleString()}
${quotation.discountAmount > 0 ? `🎁 Discount: -৳${quotation.discountAmount.toLocaleString()}\n` : ''}${quotation.deliveryCharge > 0 ? `🚚 Delivery Charge: +৳${quotation.deliveryCharge.toLocaleString()}\n` : ''}💰 *ESTIMATED TOTAL: ৳${quotation.grandTotal.toLocaleString()}*
----------------------------------------

📌 *TERMS & CONDITIONS:*
${quotation.termsConditions || company.termsAndConditions}

For order confirmation or inquiry, call us at ${company.phone}.`;
}

export function openWhatsAppQuotation(
  quotation: Quotation,
  customer: Customer | undefined,
  company: CompanySettings,
  overridePhone?: string
) {
  const targetPhone = overridePhone || quotation.customerPhone || customer?.phone || company.phone;
  const formattedPhone = formatWhatsAppPhone(targetPhone);
  const message = generateWhatsAppQuotationMessage(quotation, customer, company);
  const url = `https://api.whatsapp.com/send?phone=${formattedPhone}&text=${encodeURIComponent(message)}`;
  window.open(url, '_blank');
}

function triggerPrintWindow(element: HTMLElement, title: string = 'Document') {
  const printWindow = window.open('', '_blank', 'width=900,height=1000');
  if (!printWindow) {
    window.print();
    return;
  }

  const styles = Array.from(document.querySelectorAll('style, link[rel="stylesheet"]'))
    .map((s) => s.outerHTML)
    .join('\n');

  printWindow.document.write(`
    <!DOCTYPE html>
    <html>
      <head>
        <title>${title}</title>
        ${styles}
        <style>
          body {
            background: #ffffff !important;
            color: #000000 !important;
            padding: 20px !important;
            margin: 0 !important;
            font-family: system-ui, -apple-system, sans-serif !important;
          }
          .print\\:hidden, button { display: none !important; }
          @media print {
            body { padding: 0 !important; }
          }
        </style>
      </head>
      <body>
        <div style="max-width: 800px; margin: 0 auto;">
          ${element.innerHTML}
        </div>
        <script>
          setTimeout(() => {
            window.print();
            setTimeout(() => { window.close(); }, 500);
          }, 400);
        </script>
      </body>
    </html>
  `);
  printWindow.document.close();
}

export async function downloadInvoicePDF(containerId: string, filename: string = 'Invoice.pdf') {
  const element = document.getElementById(containerId);
  if (!element) {
    alert('প্রিন্ট ক্যানভাস বা ইনভয়েস কনটেন্ট পাওয়া যায়নি!');
    return;
  }

  try {
    const html2pdfModule = await Promise.race([
      import('html2pdf.js'),
      new Promise((_, reject) => setTimeout(() => reject(new Error('Module load timeout')), 8000)),
    ]) as any;

    const html2pdf = (html2pdfModule.default || html2pdfModule) as any;

    const opt = {
      margin: [8, 8, 8, 8],
      filename: filename,
      image: { type: 'jpeg', quality: 0.98 },
      html2canvas: { scale: 2, useCORS: true, logging: false, allowTaint: true },
      jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
    };

    await Promise.race([
      html2pdf().set(opt).from(element).save(),
      new Promise((_, reject) => setTimeout(() => reject(new Error('PDF generation timeout')), 12000)),
    ]);
  } catch (err) {
    console.warn('HTML2PDF export timed out or failed, launching fallback print window:', err);
    triggerPrintWindow(element, filename.replace('.pdf', ''));
  }
}
